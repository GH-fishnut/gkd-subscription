// 天猫校园 增强规则（本地订阅）v1
// 设备实测：Android 16 / vivo V2364A，天猫校园 5.6.2 (com.tmall.campus.and)，GKD 1.12.1
//
// 选择器来源全部为真机 dumpsys activity top 实测（非猜测），逐条标注：
//   [实测] = 已在控件树里看到该 id/类名及 bounds
//   [待验证] = 需开门页实测后再定
{
  id: 2026091400,
  name: '天猫校园增强(本地)',
  version: 23,
  author: 'DSH local',
  supportUri: 'https://gh-fishnut.github.io/gkd-subscription/',
  updateUrl: 'https://gh-fishnut.github.io/gkd-subscription/gkd.json5',
  checkUpdateUrl: 'https://gh-fishnut.github.io/gkd-subscription/gkd.version.json',
  categories: [],
  globalGroups: [],
  apps: [
    {
      id: 'com.tmall.campus.and',
      name: '天猫校园',
      groups: [
        {
          // [实测] SplashActivity 内含 FrameLayout app:id/adsFl（开屏广告容器）
          key: 1,
          name: '开屏广告',
          enable: true,
          quickFind: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          activityIds: [
            'com.tmall.campus.launcher.SplashActivity',
            'com.tmall.campus.launcher.HotSplashActivity',
          ],
          rules: [
            { key: 0, matches: '[text*="跳过"][text.length<10][visibleToUser=true]' },
            { key: 1, matches: '[vid="tv_skip"]' },
            { key: 2, matches: '[vid="img_skip"]' },
            { key: 3, matches: '[vid="skip"]' },
            { key: 4, matches: '[vid="adsFl"] [text="关闭"]' },
          ],
        },
        {
          // [实测] 首页(MainActivity)自身带广告位：fl_splash_ad(SplashAdContainerView 全屏广告容器)
          //        / fl_ad_container+tv_ad_tag(顶部横幅) / cl_ad_container(商品推广卡)
          // 注意：绝不要用 image_close / iv_close / view_close —— 实测那三个 id 属于 vivo 桌面(com.bbk.launcher2)，不是本 App
          key: 2,
          name: '首页广告弹窗',
          enable: true,
          quickFind: true,
          matchTime: 15000,
          actionMaximum: 2,
          resetMatch: 'app',
          activityIds: ['com.tmall.campus.and.main.MainActivity'],
          rules: [
            { key: 0, matches: '[vid="fl_splash_ad"] [text*="跳过"][visibleToUser=true]' },
            { key: 1, matches: '[vid="fl_splash_ad"] [text*="关闭"][visibleToUser=true]' },
            { key: 2, matches: '[text="关闭广告"][visibleToUser=true]' },
            { key: 3, matches: '[text*="跳过"][text.length<10][visibleToUser=true]' },
            // 2026-09-21 真机实测补充：首页中部 banner 广告（如 PANTENE「2/5」轮播）
            // 结构：fl_ad_container > FrameLayout > banner > [ViewPager, View(关闭)]
            // 那个关闭 View 自身 clickable=false，所以用 clickCenter 点它的中心
            { key: 5, matches: '[vid="fl_ad_container"] [vid="banner"] > View[index=1]', action: 'clickCenter' },
            // 兜底：banner 容器里出现"关闭/跳过"类文本
            { key: 6, matches: '[vid="fl_ad_container"] [text*="关闭"][visibleToUser=true]' },
            { key: 7, matches: '[vid="banner"] [text*="跳过"][visibleToUser=true]' },
          ],
        },
        {
          // [实测] 扫码页左下角广告位：fl_ad_tag > ll_ad_tag > icon_ad_container > channel_banner_iv
          //        其关闭按钮 id = channel_banner_close_iv
          key: 3,
          name: '局部广告-扫码页横幅',
          enable: true,
          quickFind: true,
          activityIds: ['com.tmall.campus.scancode.activity.ToolsCaptureActivity'],
          rules: [
            { key: 0, matches: '[vid="channel_banner_close_iv"][visibleToUser=true]' },
            { key: 1, matches: '[vid="fl_ad_tag"] [vid="channel_banner_iv"] + [clickable=true]' },
          ],
        },
        {
          // [实测] 首页右上角「扫一扫」= LinearLayout app:id/scan_view（clickable，bounds 799,146-1045,261）
          //        内含 iv_top_scan + tv_scan
          key: 5,
          name: '功能类-回到首页自动扫一扫',
          enable: true,
          quickFind: true,
          // v23：用户反馈"扫一扫慢了"。匹配窗口从 10s 拉到 25s ——
          // 首页若因开屏广告/网络慢导致 scan_view 出现晚于 10s，旧窗口会直接错过（不是点得慢，是没点上）。
          // 拉长窗口只影响"愿意等多久"，不会让它变慢。
          matchTime: 25000,
          actionMaximum: 1,
          // 2026-09 用户要求：每次回到首页都点一次（原为 resetMatch: 'app' 只在首次进入 App 时点）
          // resetMatch: 'activity' => 每次进入 MainActivity 重置计数，配合 actionMaximum: 1 保证每屏只点一次
          resetMatch: 'activity',
          activityIds: ['com.tmall.campus.and.main.MainActivity'],
          rules: [
            { key: 0, matches: '[vid="scan_view"]' },
            { key: 1, matches: '[vid="iv_top_scan"]' },
            { key: 2, matches: '[text="扫一扫"][visibleToUser=true]' },
          ],
        },
        {
          // [实测] 开门页宿主 = com.tmall.campus.bizwebview.ui.CampusWebActivity
          //        结构：root > title_bar(tv_title) > container > WebViewHolder(UC WebView，0,127-1080,2153)
          // 该 WebView 页面（door 页）的「点击开锁」按钮位于页面中部，与原 Xposed 模块
          // 「点击屏幕中心」的实现一致，故保留屏幕中心的坐标兜底。
          key: 6,
          name: '功能类-扫码后自动点击开锁',
          enable: true,
          quickFind: true,
          matchTime: 60000,
          actionMaximum: 3,
          resetMatch: 'activity',
          // 2026-09-21 实测：门锁页是 WebView，首次触发时页面未加载完，按钮点不动，
          // 要点到第二次（约 9 秒后）才生效。把延迟从 800ms 提到 1800ms 等页面就绪，
          // 并把 actionMaximum 放宽到 3 以允许必要的重试。
          actionDelay: 1800,
          activityIds: ['com.tmall.campus.bizwebview.ui.CampusWebActivity'],
          rules: [
            // 首选：能直接看到按钮文本就点它的中心
            { key: 0, matches: '[text="点击解锁"][visibleToUser=true]', action: 'clickCenter' },
            { key: 1, matches: '[text*="点击解锁"][visibleToUser=true]', action: 'clickCenter' },
            // 兼容旧版文案
            { key: 10, matches: '[text*="点击开锁"][visibleToUser=true]', action: 'clickCenter' },
            // 兜底：门锁页标题出现「开门/开锁」时，点屏幕中心（等价于原模块行为）
            {
              key: 2,
              matches: ['[vid="tv_title"][text*="开"]', '[vid="tv_title"][text*="锁"]', '[vid="tv_title"][text*="设备"]', '[vid="container"]'],
              position: { x: 'screenWidth/2', y: 'screenHeight/2' },
              action: 'clickCenter',
            },
          ],
        },
        {
          // 2026-09-21 真机截图实测：全屏推广页（饿了么/瑞幸等）
          // Activity 短名: Stub_Standard_Portrait_Activity
          // 特征文本: 「向上滑动或点击」「跳转至详情页或第三方应用」+ 左下角「广告」标识
          // 用户要求：出现即直接返回上一步
          key: 8,
          name: '全屏广告-推广页',
          enable: true,
          // 不开 quickFind：广告内容是 WebView，快速查找的索引里没有它内部的节点
          matchTime: 15000,
          actionMaximum: 2,
          resetMatch: 'activity',
          actionDelay: 500,
          rules: [
            // 2026-09-21 实测结论（决定性）：这个全屏广告**会吃掉返回键** ——
            // 手动验证：发 back 无效，必须先点右下角 X 才能关掉。
            // 因此 v8~v14 的 action:'back' 全部无效（规则匹配得再准也没用）。
            // 现在改为**坐标点击 X**：X 图标实测 bounds=[960,2250]-[1032,2322]，
            // 中心 (996,2286) = screenWidth-84, screenHeight-114。
            {
              key: 0,
              matches: '[desc="virtualNode"]',
              position: { x: 'screenWidth-84', y: 'screenHeight-114' },
              action: 'click',
            },
            // ① 悬浮球类广告（实测 2026-09-21）
            //   特征文字「关闭悬浮球可继续浏览应用」作为触发锚点，
            //   但**实际要点的仍然是 X**（用户实测：点提示文字无效）。
            //   这种广告的 X 在右侧中部 [975,513] 中心 (997,543)，
            //   与全屏广告的右下角完全不同，所以单独给一套坐标。
            {
              key: 1,
              matches: '[text*="关闭悬浮球"]',
              position: { x: 'screenWidth-83', y: 543 },
              action: 'click',
            },
            // ② 全屏推广广告（实测 2026-09-21）：X 固定在右下角
            {
              key: 2,
              matches: '[text="点击取消静音"][visibleToUser=true]',
              position: { x: 'screenWidth-84', y: 'screenHeight-114' },
              action: 'click',
            },
          ],
        },
        {
          // 2026-09-21 GKD 快照实测（决定性）：宿主 Activity = com.tmall.campus.weex2.WeexActivity
          //   快照导出的节点树只有 11 个节点，全是容器：
          //     action_bar_root > content > ViewGroup > container > FrameLayout
          //       > render_container > FrameLayout > FrameLayout(childCount=0)
          //   页面上肉眼可见的「¥0.01」「支付成功」「完成」「查看订单」全部【不在】无障碍树里。
          // 原因：weex2 是自绘渲染（不生成原生 View），无障碍永远看不到页面内容 ——
          //   这正是 v18 的 [text="支付成功"] 从未触发过的原因（死规则）。
          // 结论：触发信号只能取 Activity 层(activityIds) + 树里真实存在的容器 id，不能依赖文本。
          key: 7,
          name: '功能类-支付成功页自动返回',
          enable: true,
          // 树是空壳，quickFind 索引里没有可用内容，关掉更稳
          quickFind: false,
          matchTime: 20000,
          actionMaximum: 8,
          resetMatch: 'activity',
          // 时间线实测（GKD 界面日志）：22:09:09 进 WeexActivity → 22:09:13 广告页，中间约 4 秒。
          // 花形加载动画（中央白框 + 笑脸花 + 背景遮罩）就在这 4 秒里出现，同样读不到节点。
          // 2200ms 后返回，赶在花成型与广告露脸之前。
          // 2026-09-22 v20：用户要求"还没看到就已经被关掉"。
          // 关键认识：广告一旦弹出来才去关，必然有可见闪现（GKD 必须先收到窗口事件才能动作）。
          // 想要"看不见"，只能抢在它前面 —— 支付成功页到广告之间有约 4 秒，之前却故意等了 2200ms。
          // 现在改为：进页面 500ms 就返回，被吞就每 500ms 重试，最多 4 次（覆盖约 2 秒）。
          // 2026-09-22 v22：用户要求步长 200ms，且指出"广告弹窗可能是随机出的"。
          // 应对随机性靠两点：①第一枪极早(200ms) ②后续密集重试拉开覆盖窗。
          // 八枪落点：200/400/600/800/1000/1200/1400/1600ms（步长 200，覆盖 1.6 秒）。
          // 页面一旦离开 WeexActivity，剩余重试自动失效（activityIds 限定），不会多退。
          actionDelay: 200,
          actionCd: 200,
          activityIds: ['com.tmall.campus.weex2.WeexActivity'],
          rules: [
            // 主锚点：快照树里实测存在的 Weex 内容容器
            { key: 0, matches: '[vid="render_container"]', action: 'back' },
            // 兜底：更外层的容器（同样来自快照实测）
            { key: 1, matches: '[vid="container"]', action: 'back' },
            // 保底：万一某些场景该页是原生实现，文本规则仍可命中（本页不会命中，无副作用）
            { key: 2, matches: '[text="支付成功"][visibleToUser=true]', action: 'back' },
          ],
        },
      ],
    },
  ],
}
